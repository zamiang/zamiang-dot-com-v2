{
  "name": "brennanmoore-astro-blog",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "astro build",
    "check": "astro check",
    "check:design-tokens": "node scripts/check-design-tokens.mjs",
    "dev": "astro dev",
    "preview": "astro preview",
    "audit-dependencies": "npm audit --audit-level=high --production",
    "format": "prettier --write \"*.md\" \"{src,__tests__,scripts,.claude,.serena,docs}/**/*.{ts,tsx,js,css,md,astro}\"",
    "format:check": "prettier --list-different \"*.md\" \"{src,__tests__,scripts,.claude,.serena,docs}/**/*.{ts,tsx,js,css,md,astro}\"",
    "knip": "knip",
    "knip:fix": "knip --fix",
    "lint": "eslint . --ext .ts,.tsx,.astro --max-warnings=0",
    "lint:fix": "eslint . --ext .ts,.tsx,.astro --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:watch": "vitest --watch",
    "test:watch:coverage": "vitest --watch --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@astrojs/react": "5.0.6",
    "@astrojs/rss": "4.0.18",
    "@astrojs/sitemap": "3.7.3",
    "@notionhq/client": "5.22.0",
    "@tailwindcss/vite": "4.3.0",
    "astro": "6.4.2",
    "axios": "1.16.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "notion-to-md": "3.1.9",
    "ogl": "1.0.11",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-markdown": "10.1.0",
    "rehype-raw": "7.0.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@tailwindcss/postcss": "4.3.0",
    "@tailwindcss/typography": "0.5.19",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@trivago/prettier-plugin-sort-imports": "6.0.2",
    "@types/node": "25.9.1",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "@types/react-syntax-highlighter": "15.5.13",
    "@vitejs/plugin-react": "5.1.4",
    "@vitest/coverage-istanbul": "4.1.8",
    "eslint": "10.4.1",
    "eslint-plugin-astro": "1.7.0",
    "jsdom": "29.1.1",
    "knip": "6.15.0",
    "postcss": "8.5.15",
    "prettier": "3.8.3",
    "prettier-plugin-astro": "0.14.1",
    "react-syntax-highlighter": "16.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.60.0",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.1.8"
  },
  "overrides": {
    "minimatch": ">=10.2.1",
    "lodash": ">=4.17.22",
    "tsconfck": {
      "typescript": "$typescript"
    }
  },
  "engines": {
    "node": "24.x"
  }
}
