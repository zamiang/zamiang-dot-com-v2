---
/**
 * Homepage
 * Spare, professional resume-style layout with two-column body
 */

import { getCollection } from 'astro:content';

import PhotoCard from '../components/PhotoCard.astro';
import PostCard from '../components/PostCard.astro';
import SectionRail from '../components/islands/SectionRail';
import BaseLayout from '../layouts/BaseLayout.astro';
import { VBC_TITLE, config } from '../lib/config';

// Load content from collections - fail the build if content is unavailable
const posts = await getCollection('posts');
const vbcPosts = (await getCollection('vbcPosts')).sort((a, b) =>
  a.data.title.localeCompare(b.data.title),
);
const photos = (await getCollection('photos')).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
);

// Fail the build if no content is available (indicates Notion API issue)
if (posts.length === 0 && vbcPosts.length === 0 && photos.length === 0) {
  throw new Error(
    'Build failed: No content loaded from Notion. Check NOTION_TOKEN and data source IDs.',
  );
}

const siteUrl = config.site.url;

// Homepage writing list: the VBC series is shown as a single card that sorts
// chronologically alongside individual posts (dated by its first part), rather
// than being pinned to the top. Limit to 5 total cards.
const HOMEPAGE_WRITING_CARDS = 5;
const vbcCard =
  vbcPosts.length > 0
    ? {
        slug: vbcPosts[0].data.slug,
        title: VBC_TITLE,
        date: vbcPosts[0].data.date,
        excerpt: `A ${vbcPosts.length}-part series on why fixing American healthcare from the inside is harder than it looks.`,
      }
    : null;
const writingCards = [...posts.map((p) => p.data), ...(vbcCard ? [vbcCard] : [])]
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime())
  .slice(0, HOMEPAGE_WRITING_CARDS);

// Schema.org JSON-LD for homepage
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${siteUrl}/#person`,
      name: 'Brennan Moore',
      url: siteUrl,
      image: `${siteUrl}/about.jpg`,
      jobTitle: 'CTO / Engineering Leader',
      description:
        'I make clean software in messy industries — most recently healthcare and value-based care. Writing, photography, and notes from the work.',
      sameAs: [],
    },
    {
      '@type': 'Blog',
      '@id': `${siteUrl}/#blog`,
      name: config.site.title,
      description: config.site.description,
      url: siteUrl,
      author: {
        '@id': `${siteUrl}/#person`,
      },
      blogPost: posts.slice(0, 5).map((post) => ({
        '@type': 'BlogPosting',
        '@id': `${siteUrl}/writing/${post.data.slug}`,
        headline: post.data.title,
        datePublished: new Date(post.data.date).toISOString(),
      })),
    },
  ],
};
---

<BaseLayout hideDesktopNav>
  <Fragment slot="json-ld">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <SectionRail client:visible />

  {/* Compact Header */}
  <header class="resume-header">
    <img
      src="/about.jpg"
      alt="Brennan Moore - Engineering Leader and CTO"
      width="84"
      height="84"
      class="resume-header-photo"
      loading="eager"
    />
    <div class="resume-header-info">
      <h1>Brennan Moore</h1>
      <p>I make clean software in messy industries.</p>
      <div class="resume-links">
        <a
          href="https://www.linkedin.com/in/brennan-moore/"
          target="_blank"
          rel="noopener noreferrer">LinkedIn</a
        >
        <span class="sep" aria-hidden="true">&middot;</span>
        <a href="/brennan-moore-resume-2026.pdf" download>Resume</a>
        <span class="sep" aria-hidden="true">&middot;</span>
        <a href="https://github.com/zamiang" target="_blank" rel="noopener noreferrer">GitHub</a>
      </div>
    </div>
  </header>

  {/* Primary Content: Writing + Photography */}
  <div class="homepage-primary">
    {
      posts.length > 0 && (
        <section id="writing">
          <header class="bm-section-header">
            <div class="bm-eyebrow" aria-label="Section 01, Writing">
              <span class="bm-eyebrow-mark" aria-hidden="true">
                &sect;
              </span>
              <span class="bm-eyebrow-num">01</span>
              <span class="bm-eyebrow-sep" aria-hidden="true">
                &middot;
              </span>
              <span class="bm-eyebrow-label">Writing</span>
            </div>
            <h2 class="bm-section-display-title">Recent Essays</h2>
            <p class="bm-section-tagline">How I got my gray hairs.</p>
          </header>
          {writingCards.map((post) => (
            <PostCard post={post} />
          ))}
          {posts.length + (vbcCard ? 1 : 0) > writingCards.length && (
            <a href="/writing" class="view-all-link">
              View all writing →
            </a>
          )}
        </section>
      )
    }

    {
      photos.length > 0 && (
        <section id="photography">
          <header class="bm-section-header">
            <div class="bm-eyebrow" aria-label="Section 02, Photography">
              <span class="bm-eyebrow-mark" aria-hidden="true">
                &sect;
              </span>
              <span class="bm-eyebrow-num">02</span>
              <span class="bm-eyebrow-sep" aria-hidden="true">
                &middot;
              </span>
              <span class="bm-eyebrow-label">Photography</span>
            </div>
            <h2 class="bm-section-display-title">Recent Photos</h2>
            <p class="bm-section-tagline">The system reveals itself when you hover.</p>
          </header>
          <div class="homepage-photo-grid">
            {photos.slice(0, 8).map((post) => (
              <PhotoCard post={post.data} shouldHideText />
            ))}
          </div>
          {photos.length > 8 && (
            <a href="/photos" class="view-all-link">
              View all photos →
            </a>
          )}
        </section>
      )
    }
  </div>

  {/* Secondary Content: Currently, Experience, Publications */}
  <div class="resume-layout">
    <div>
      <section id="currently" class="currently-section">
        <header class="bm-section-header">
          <div class="bm-eyebrow" aria-label="Section 03, Currently">
            <span class="bm-eyebrow-mark" aria-hidden="true">&sect;</span>
            <span class="bm-eyebrow-num">03</span>
            <span class="bm-eyebrow-sep" aria-hidden="true">&middot;</span>
            <span class="bm-eyebrow-label">Currently</span>
          </div>
          <h2 class="bm-section-display-title">About Me</h2>
        </header>
        <p>
          Currently I'm consulting while working on <a href="https://www.kelp.nyc/">Kelp</a>, an AI
          assistant that helps executives stay on top of their increasingly vast scopes. I'm drawn
          to product problems where the hard part is messy data, complex requirements, and
          challenging customers.
        </p>
        <p>Here's a little bit more about me:</p>
        <p>
          I came into tech through art. Art high school (UNCSA), a BFA from the Museum School in
          Boston, then a couple of years as a visiting researcher at the MIT Media Lab and MIT
          CSAIL publishing in human-computer interaction (HCI), then leading web engineering at
          Artsy through live auctions and art fairs. My mother is a home health worker, and after
          seeing how much her role had changed, I decided to use my HCI research to help care
          workers focus on the right patients at the right time and joined Cityblock Health as the
          first engineer. I grew with it from IC to running the engineering org as we hit a $1B+
          valuation with fewer than 25 engineers (pre-AI). I then moved to CTO of Firsthand,
          holding the technology org together through growth to ~28 offices and then a wind-down.
          I've seen that full startup cycle and am more excited than ever to put that same
          small-team-against-hard-requirements energy into building AI that's trustworthy enough to
          use for critical tasks.
        </p>
        <p>
          Outside of work, I'm in Park Slope with my partner, spending more time building apps to
          teach me Taiwan Mandarin than studying, and writing at zamiang.com about team trust,
          engineering leadership, and why VBC might just be too hard a problem to solve.
        </p>
      </section>

      <section id="work">
        <header class="bm-section-header">
          <div class="bm-eyebrow" aria-label="Section 04, Experience">
            <span class="bm-eyebrow-mark" aria-hidden="true">&sect;</span>
            <span class="bm-eyebrow-num">04</span>
            <span class="bm-eyebrow-sep" aria-hidden="true">&middot;</span>
            <span class="bm-eyebrow-label">Experience</span>
          </div>
          <h2 class="bm-section-display-title">Selected Work</h2>
        </header>

        <div class="work-card">
          <div class="work-card-header">
            <time class="work-card-date">2022–2025</time>
            <span class="work-card-sep" aria-hidden="true">&middot;</span>
            <span class="work-card-role">CTO</span>
          </div>
          <h3 class="work-card-title">
            <a href="https://www.firsthandcares.com">Firsthand</a>
          </h3>
          <p class="work-card-description">
            Led the technology organization across Product, Software, Data, IT, and Security,
            scaling the team from 3 to 25 while supporting rapid physical expansion across 28
            offices. Architected helpinghand, our proprietary AI-powered care management tool, and
            secured HITRUST r2 certification under strict deadlines.
          </p>
        </div>

        <div class="work-card">
          <div class="work-card-header">
            <time class="work-card-date">2022–2026</time>
            <span class="work-card-sep" aria-hidden="true">&middot;</span>
            <span class="work-card-role">Founder</span>
          </div>
          <h3 class="work-card-title">
            <a href="https://www.kelp.nyc/">Kelp</a>
          </h3>
          <p class="work-card-description">
            Founded Kelp to filter our ocean of information down to just what you need right now.
            Built a Chrome Extension with integrations across major workplace platforms. Now it is
            an AI assistant focused on helping executives stay current on industry, technology, and
            cultural shifts.
          </p>
        </div>

        <div class="work-card">
          <div class="work-card-header">
            <time class="work-card-date">2017–2021</time>
            <span class="work-card-sep" aria-hidden="true">&middot;</span>
            <span class="work-card-role">Founding Engineer</span>
          </div>
          <h3 class="work-card-title">
            <a href="https://www.cityblock.com/">Cityblock Health</a>
          </h3>
          <p class="work-card-description">
            As the 3rd team member, I was instrumental in incubating and launching Cityblock from
            within Alphabet's Sidewalk Labs. My team built the core data and software technology
            foundation, including data-sharing partnerships with payers and Commons&mdash;the
            proprietary care management platform.
          </p>
        </div>

        <div class="work-card">
          <div class="work-card-header">
            <time class="work-card-date">2009–2015</time>
            <span class="work-card-sep" aria-hidden="true">&middot;</span>
            <span class="work-card-role">Lots of projects</span>
          </div>
          <h3 class="work-card-title">
            <a href="https://www.linkedin.com/in/brennan-moore/">More on LinkedIn</a>
          </h3>
          <p class="work-card-description">
            Many past projects such as leading Artsy.net's public web presence and auctions,
            Motivate (Citi Bike), HCI research at MIT CSAIL and working at the MIT Media lab on
            visualizations for Ars Electronica.
          </p>
        </div>
      </section>

      <section id="publications">
        <header class="bm-section-header">
          <div class="bm-eyebrow" aria-label="Section 05, Publications">
            <span class="bm-eyebrow-mark" aria-hidden="true">&sect;</span>
            <span class="bm-eyebrow-num">05</span>
            <span class="bm-eyebrow-sep" aria-hidden="true">&middot;</span>
            <span class="bm-eyebrow-label">Publications</span>
          </div>
          <h2 class="bm-section-display-title">HCI Publications</h2>
        </header>
        <div class="publication-intro">
          <p>
            At MIT CSAIL (2008&ndash;2010), in David Karger's group, I built systems around <i
              >personal informatics</i
            >, helping people make sense of their own digital lives. Most
            software is designed to make us more productive, so I asked whether user-controlled,
            passively tracked data like web browsing, fitness trackers, messages and calendars could be
            used to foster:
          </p>
          <ul>
            <li>Self-understanding: Am I unfocused and burnt out, and need a recharge?</li>
            <li>Social awareness: Am I losing touch with friends I care about?</li>
            <li>
              Lightweight automation: When I get a message from my boss, can I automate a response?
            </li>
          </ul>
        </div>
        <div class="publication-entry">
          <h4>
            <a href="/papers/1772690.1772787.pdf" target="_blank" rel="noopener noreferrer">
              Atomate It! End-user Context-Sensitive Automation Using Heterogeneous Information
              Sources on the Web
            </a>
          </h4>
          <p class="publication-meta">
            <i>Van Kleek, Moore, Karger, André, schraefel</i> &mdash; WWW 2010
          </p>
          <p class="publication-summary">
            A reactive personal-automation engine that treats RSS/ATOM feeds from social and
            life-tracking sites as sensor streams, unifying them into a single RDF model of people,
            places, and things. Users specify context-sensitive behaviors &mdash; &ldquo;remind me
            to take out the trash when I get home on Tuesdays&rdquo; &mdash; through a constrained
            natural-language interface, bringing end-user automation to non-programmers.
          </p>
          <p class="publication-links">
            <a
              href="https://dl.acm.org/doi/10.1145/1772690.1772787"
              target="_blank"
              rel="noopener noreferrer">ACM</a
            >
          </p>
        </div>
        <div class="publication-entry">
          <h4>
            <a
              href="/papers/moore_assisted_self_reflection.pdf"
              target="_blank"
              rel="noopener noreferrer"
            >
              Assisted Self Reflection: Combining Lifetracking, Sensemaking &amp; Personal
              Information Management
            </a>
          </h4>
          <p class="publication-meta">
            <i>Moore, Van Kleek, Karger, schraefel</i> &mdash; CHI 2010 Workshop
          </p>
          <p class="publication-summary">
            Introduces Poyozo, an automatic diary that pulls together data from the life-tracking
            tools people already use (RescueTime, Nike+, and the like) and presents it through
            familiar personal-information-management metaphors like the calendar. Rather than
            optimizing for productivity, it aims to give people the situational clarity to reflect
            on &mdash; and actually understand &mdash; how they spend their lives.
          </p>
          <p class="publication-links">
            <a
              href="https://scholar.google.com/citations?view_op=view_citation&hl=en&user=jlJmQGcAAAAJ&citation_for_view=jlJmQGcAAAAJ:u5HHmVD_uO8C"
              target="_blank"
              rel="noopener noreferrer">Google Scholar</a
            >
          </p>
        </div>
        <div class="publication-entry">
          <h4>
            <a href="/papers/1753846.1754032.pdf" target="_blank" rel="noopener noreferrer">
              Eyebrowse: Real-Time Web Activity Sharing and Visualization
            </a>
          </h4>
          <p class="publication-meta">
            <i>Van Kleek, Xu, Moore, Karger</i> &mdash; CHI 2010 Extended Abstracts
          </p>
          <p class="publication-summary">
            A Firefox extension and companion site that let people opt in to logging and selectively
            publishing their web browsing in real time. Three goals: help individuals understand how
            they spend time online through visualizations and statistics, foster social discovery
            and awareness, and build a public corpus of browsing trails &mdash; while examining how
            sharing affects feelings of self-exposure and privacy.
          </p>
          <p class="publication-links">
            <a
              href="https://dl.acm.org/doi/10.1145/1753846.1754032"
              target="_blank"
              rel="noopener noreferrer">ACM</a
            >
          </p>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>
