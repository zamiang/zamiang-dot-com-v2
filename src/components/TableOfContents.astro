---
/**
 * TableOfContents Component (Astro)
 * Shows a navigation sidebar for post headings
 */

export interface TocItem {
  id: string;
  text: string;
  level: number;
}

interface Props {
  items: TocItem[];
}

const { items } = Astro.props;

// Don't render if less than 3 items
if (items.length < 3) {
  return null;
}

// Find the minimum heading level to use as baseline for indentation
const minLevel = Math.min(...items.map((item) => item.level));

// Indentation is applied via Tailwind classes (not inline styles) because the
// site's CSP blocks inline `style` attributes: Astro auto-hashes its own inline
// <style> tags, and per the CSP spec a present hash makes 'unsafe-inline' inert.
// Class names must be written as full literals so Tailwind detects them.
const indentClasses = ['ml-0', 'ml-4', 'ml-8', 'ml-12', 'ml-16'];
const indentFor = (level: number) =>
  indentClasses[Math.min(level - minLevel, indentClasses.length - 1)];
---

<nav
  aria-label="Table of contents"
  class="toc mb-8 p-5 bg-muted/50 border border-border/40 rounded-lg"
>
  <p
    class="text-xs font-semibold uppercase tracking-wide text-muted-foreground mb-3"
    aria-hidden="true"
  >
    In This Article
  </p>
  <ul class="space-y-1.5 m-0 p-0 list-none">
    {
      items.map((item) => (
        <li class={`m-0 ${indentFor(item.level)}`}>
          <a
            href={`#${item.id}`}
            class="text-sm text-foreground/70 hover:text-foreground transition-colors duration-150 !border-none !no-underline leading-relaxed"
          >
            {item.text}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
