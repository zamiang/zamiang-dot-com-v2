---
/**
 * PhotoCard Component (Astro)
 * Displays a photo preview with image, date, and title.
 *
 * variant="inspect" (default) renders the photo with the inspect treatment:
 * cross-fades to an edge-detected line-art layer with a copper HUD on hover.
 * Requires the `#bm-edge` SVG filter on the page (inlined in BaseLayout).
 * variant="default" disables the treatment for contexts that need a quiet image.
 */

import { format } from 'date-fns';
import { photoFileId } from '../lib/telemetry';

interface Props {
  post: {
    slug: string;
    title: string;
    date: string;
    coverImage: string;
  };
  shouldHideText?: boolean;
  priority?: boolean;
  variant?: 'default' | 'inspect';
}

const { post, shouldHideText = false, priority = false, variant = 'inspect' } = Astro.props;

const postDate = new Date(post.date);
const isoDate = postDate.toISOString().split('T')[0];
const imgSrc = `/images/photos/${post.coverImage}`;
const href = `/photos/${post.slug}`;
const ariaLabel = shouldHideText ? post.title : `View photo: ${post.title}`;

const fileId = photoFileId(post.slug);
const dateLabel = format(postDate, 'yyyy.MM.dd');
---

<div class="photo-card group">
  {
    variant === 'inspect' ? (
      <div class="bm-photo bm-photo--inspect">
        <a href={href} aria-label={ariaLabel}>
          {/* Two <img>s with identical src are intentional: the second is the
              source for the #bm-edge line-art layer that cross-fades on hover.
              Cache hit on the network; doubles GPU texture cost per card. */}
          <img
            class="bm-photo-base"
            src={imgSrc}
            alt={post.title}
            loading={priority ? 'eager' : 'lazy'}
            decoding="async"
          />
          <img
            class="bm-photo-line"
            src={imgSrc}
            alt=""
            aria-hidden="true"
            loading="lazy"
            decoding="async"
          />
        </a>
        <div class="bm-hud" aria-hidden="true">
          <div class="bm-hud-brackets">
            <span class="tl" />
            <span class="tr" />
            <span class="bl" />
            <span class="br" />
          </div>
          <div class="bm-hud-reticle">
            <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-linecap="round">
              <line x1="24" y1="6" x2="24" y2="42" stroke-width="1.25" />
              <line x1="6" y1="24" x2="42" y2="24" stroke-width="1.25" />
            </svg>
          </div>
          <div class="bm-hud-telemetry">
            <div class="bm-hud-col">
              <span class="bm-hud-lbl">File</span>
              <span class="bm-hud-val">{fileId}</span>
            </div>
            <div class="bm-hud-col bm-hud-col--right">
              <span class="bm-hud-lbl">Date</span>
              <span class="bm-hud-val">{dateLabel}</span>
            </div>
          </div>
        </div>
      </div>
    ) : (
      <div class="bm-photo">
        <a href={href} aria-label={ariaLabel}>
          <img
            src={imgSrc}
            alt={post.title}
            loading={priority ? 'eager' : 'lazy'}
            decoding="async"
          />
        </a>
      </div>
    )
  }
  {
    !shouldHideText && (
      <p class="photo-card-date">
        <time datetime={isoDate}>{format(postDate, 'MMM d, yyyy')}</time>
      </p>
    )
  }
  {
    !shouldHideText && (
      <h3 class="photo-card-title font-serif font-medium">
        <a href={href}>{post.title}</a>
      </h3>
    )
  }
</div>
